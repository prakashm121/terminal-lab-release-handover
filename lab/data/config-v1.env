# CloudRetail Checkout Service Environment Configuration
# Version: v2.4.0 (Stable Production)

APP_NAME=checkout-service
APP_ENV=production
PORT=8080
LOG_LEVEL=info
ENABLE_METRICS=true

# Database Connection Pool Settings
DB_HOST=postgres-cluster.internal
DB_PORT=5432
DB_NAME=checkout_db
DB_USER=checkout_app
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_TIMEOUT_MS=5000

# Upstream Integrations
AUTH_SERVICE_URL=http://auth-service.internal:8080
INVENTORY_SERVICE_URL=http://inventory-api.internal:8080
PAYMENT_GATEWAY_URL=https://api.stripe.com/v1
PAYMENT_RETRY_ATTEMPTS=3

# Health & Resiliency
HEALTHCHECK_INTERVAL_SEC=10
CIRCUIT_BREAKER_ENABLED=false
CACHE_TTL_SECONDS=300
